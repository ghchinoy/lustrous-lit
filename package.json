{
  "name": "@ghchinoy/lustrous-lit",
  "version": "0.2.0",
  "description": "Lustrous Design System for Lit 3 web components: theme tokens, typography, bundled fonts, layout primitives, accessible form controls, and top-layer overlays.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghchinoy/lustrous-lit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "web-components",
    "lit",
    "custom-elements",
    "lustrous",
    "accessibility",
    "tokens"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/*.d.ts",
      "import": "./dist/components/*/*.js"
    },
    "./theme.css": "./dist/lustrous-theme.css",
    "./fonts.css": "./fonts/lustrous-fonts.css",
    "./fonts/*": "./fonts/*",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/**/*.js",
    "./src/index.ts",
    "./src/components/**/*.ts",
    "*.css"
  ],
  "files": [
    "dist",
    "fonts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.stories.ts",
    "!src/**/screenshots",
    "!src/test",
    "custom-elements.json",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs && pnpm run analyze && node scripts/sync-plugin.mjs",
    "analyze": "cem analyze",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "check:plugin": "bash scripts/validate-plugins.sh && node scripts/sync-plugin.mjs --check",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p examples/app",
    "test": "vitest run",
    "test:browsers": "LUSTROUS_BROWSERS=chromium,firefox,webkit vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots=all --grep-invert \"no orphaned baselines\" && node scripts/prune-visual-snapshots.mjs && node scripts/visual-webp.mjs pack",
    "test:visual:ci": "playwright test -c playwright.visual.config.ts --update-snapshots=none",
    "prepublishOnly": "pnpm run build",
    "example": "vite examples/app",
    "build:example": "vite build examples/app",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:ssr": "node scripts/ssr-smoke.mjs && node scripts/ssr-hydrate.mjs",
    "check:clean": "node scripts/check-clean.mjs"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit-labs/ssr": "^4.1.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/web-components-vite": "^10.6.3",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.13.0",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.3",
    "typescript": "^5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.23.4"
  }
}
